# User-facing app name (working name).
APP_NAME=Andaaza

# Transcription (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Recipe structuring (Anthropic). Empty effort = API default; empty temperature = not sent.
# Sonnet 5.5 rejects a non-default temperature. If you switch back to Sonnet 4.5,
# clear the effort and you may set a temperature (e.g. 0.3).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_RECIPE_MODEL=claude-sonnet-5-5
ANTHROPIC_RECIPE_MAX_TOKENS=16000
ANTHROPIC_RECIPE_EFFORT=medium
ANTHROPIC_RECIPE_TEMPERATURE=

# File storage: local (default) or s3 (AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local
# S3_BUCKET=cookbook-files
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Domain printed into QR codes (keep it forever). Empty = the request's own URL.
PUBLIC_BASE_URL=

# Background worker. Empty = process uploads inside the request (local dev).
# Set it (Railway Redis: ${{Redis.REDIS_URL}}) and run `python worker.py` as a second service.
REDIS_URL=

# Database. Empty = local SQLite at instance/cookbook.db.
# Local Postgres from docker-compose: postgresql://cookbook:cookbook@localhost:5432/cookbook
DATABASE_URL=

# Required when FLASK_DEBUG is off. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Local development only. Defaults to false (production) when unset.
FLASK_DEBUG=true
