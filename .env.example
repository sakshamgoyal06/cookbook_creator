# Transcription (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Recipe structuring (Anthropic). Empty effort = API default; empty temperature = not sent.
# Sonnet 5.5 rejects a non-default temperature. If you switch back to Sonnet 4.5,
# clear the effort and you may set a temperature (e.g. 0.3).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_RECIPE_MODEL=claude-sonnet-5-5
ANTHROPIC_RECIPE_MAX_TOKENS=16000
ANTHROPIC_RECIPE_EFFORT=medium
ANTHROPIC_RECIPE_TEMPERATURE=

FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
